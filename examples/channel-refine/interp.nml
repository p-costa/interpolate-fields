! CaNS turbulent channel at Re_tau = 5200 (uniform x and y, non-uniform z), interpolated onto a
! finer grid along y and z, from a single-precision legacy checkpoint into single-precision
! per-variable files, to be used as an initial condition; the wall velocity bcvel(:,3,1) = -1 is
! that of a run in a reference frame moving with the bulk velocity, and the mean pressure is
! removed, so that its fluctuations are resolved in single precision
&interp
dims(1:3) = 1, 4, 30
input_format = 'legacy', input_file = 'data/fld_i.bin'
output_prefix = 'data/fld_o', output_precision = 'single'
is_reset_time = T
/
&grid_in
ng(1:3) = 3456, 2970, 976, l(1:3) = 6.283185307179586, 3.141592653589793, 2.
grid_files(1:3) = '', '', 'data/grid_i.bin'
/
&grid_out
ng(1:3) = 3456, 3840, 1648, l(1:3) = 6.283185307179586, 3.141592653589793, 2.
grid_files(1:3) = '', '', 'data/grid_o.bin'
/
&bc
cbcvel(0:1,1:3,1) = 'P','P',  'P','P',  'D','D'
cbcvel(0:1,1:3,2) = 'P','P',  'P','P',  'D','D'
cbcvel(0:1,1:3,3) = 'P','P',  'P','P',  'D','D'
cbcpre(0:1,1:3)   = 'P','P',  'P','P',  'N','N'
bcvel(0:1,1:3,1)  = 0.,0.,  0.,0.,  -1.,-1.
/
&operations
is_remove_mean(4) = T
/
